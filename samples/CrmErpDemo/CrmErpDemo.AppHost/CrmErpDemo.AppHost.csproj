<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>crmerpdemo-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The AppHost build targets, and AddDotnetProject for the projects Program.cs adds by path. -->
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.Functions" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.Sql" Version="17.0.0" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.DbGate" Version="17.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The catalog: Program.cs names its platform type and passes its assembly to the WebApp. -->
    <ProjectReference Include="..\CrmErpDemo.Contracts\CrmErpDemo.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\NimBus.ServiceBusEmulator.AspireHosting\NimBus.ServiceBusEmulator.AspireHosting.csproj" />
    <!-- Program.cs adds every other project by path (AddDotnetProject), which needs no reference
         here. The three Functions projects are different: AddAzureFunctionsProject takes the
         generated Projects.* type, so their references are marked as Aspire resources. -->
    <ProjectReference Include="..\Erp.Adapter.Functions\Erp.Adapter.Functions.csproj" IsAspireProjectResource="true" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DataPlatform.Adapter.Functions\DataPlatform.Adapter.Functions.csproj" IsAspireProjectResource="true" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\src\NimBus.Resolver\NimBus.Resolver.csproj" IsAspireProjectResource="true" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
