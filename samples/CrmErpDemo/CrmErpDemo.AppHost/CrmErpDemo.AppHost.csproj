<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>crmerpdemo-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Azure.Functions" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Azure.Sql" Version="13.5.4" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.DbGate" Version="13.5.0" />
    <!-- Force the patched MessagePack over Aspire's vulnerable transitive 2.5.192
         (CVE-2026-48109 et al., patched in 2.5.301) so the audited Release build passes.
         This is a security FLOOR, not a version to keep current: nothing in this repo
         calls MessagePack, and Aspire — which does, for the dashboard's resource
         stream — is built against 2.x. MessagePack 3.x resolves and the AppHost even
         starts on it, but it puts a major under a dependency that did not ask for one,
         where a break would surface as a serialization failure on some dashboard path
         rather than at build time. 3.x buys nothing here; 2.5.302 already clears the
         advisory. Raise this only when Aspire itself moves. -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrmErpDemo.Contracts\CrmErpDemo.Contracts.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\CrmErpDemo.Provisioner\CrmErpDemo.Provisioner.csproj" />
    <ProjectReference Include="..\Crm.Api\Crm.Api.csproj" />
    <ProjectReference Include="..\Crm.Adapter\Crm.Adapter.csproj" />
    <ProjectReference Include="..\Erp.Api\Erp.Api.csproj" />
    <ProjectReference Include="..\Erp.Adapter.Functions\Erp.Adapter.Functions.csproj" />
    <ProjectReference Include="..\DataPlatform.Adapter.Functions\DataPlatform.Adapter.Functions.csproj" />
    <ProjectReference Include="..\CrmErpDemo.AgentZone\CrmErpDemo.AgentZone.csproj" />
    <ProjectReference Include="..\EnrichmentAgent\EnrichmentAgent.csproj" />
    <ProjectReference Include="..\PartnerPortal\PartnerPortal.csproj" />
    <ProjectReference Include="..\..\..\src\NimBus.Resolver\NimBus.Resolver.csproj" />
    <ProjectReference Include="..\..\..\src\NimBus.WebApp\NimBus.WebApp.csproj" />
    <ProjectReference Include="..\..\..\src\NimBus.ServiceBusEmulator\NimBus.ServiceBusEmulator.csproj" />
    <ProjectReference Include="..\..\..\src\NimBus.ServiceBusEmulator.AspireHosting\NimBus.ServiceBusEmulator.AspireHosting.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
