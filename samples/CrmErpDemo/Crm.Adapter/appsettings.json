{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Azure": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "Crm": {
    "CircuitBreaker": {
      "MinimumThroughput": 5,
      "FailurePercentageThreshold": 50,
      "SamplingWindowSeconds": 60,
      "BreakDurationSeconds": 20,
      "HalfOpenProbeCount": 2
    }
  }
}
