<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Description>Reference runner for an unattended NimBus failure-handling agent (Spec 044 Phase 4): gets a workload token, checks capabilities, fetches the handle-failures prompt over MCP and runs a headless coding agent.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FailureAgent.Runner.Tests" />
  </ItemGroup>

</Project>
