<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>dynamicsbcdemo-apphost</UserSecretsId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Azure.Functions" Version="13.5.4" />
    <!-- Pins a patched transitive version (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); remove once upstream packages depend on >= 10.0.13. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Force the patched MessagePack over Aspire's vulnerable transitive 2.5.192
         (CVE-2026-48109 et al., patched in 2.5.301) so the audited Release build passes.
         This is a security FLOOR, not a version to keep current: nothing in this sample
         calls MessagePack, and Aspire — which does, for the dashboard's resource stream —
         is built against 2.x. Raise this only when Aspire itself moves. Same pin and
         reasoning as samples/CrmErpDemo/CrmErpDemo.AppHost. -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicsBcDemo.Contracts\DynamicsBcDemo.Contracts.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\DynamicsBcDemo.Provisioner\DynamicsBcDemo.Provisioner.csproj" />
    <ProjectReference Include="..\D365Sales.Api\D365Sales.Api.csproj" />
    <ProjectReference Include="..\D365Sales.Adapter\D365Sales.Adapter.csproj" />
    <ProjectReference Include="..\BusinessCentral.Api\BusinessCentral.Api.csproj" />
    <ProjectReference Include="..\BusinessCentral.Adapter\BusinessCentral.Adapter.csproj" />
    <ProjectReference Include="..\..\..\src\NimBus.Resolver\NimBus.Resolver.csproj" />
    <ProjectReference Include="..\..\..\src\NimBus.WebApp\NimBus.WebApp.csproj" />
    <ProjectReference Include="..\..\..\src\NimBus.ServiceBusEmulator\NimBus.ServiceBusEmulator.csproj" />
    <ProjectReference Include="..\..\..\src\NimBus.ServiceBusEmulator.AspireHosting\NimBus.ServiceBusEmulator.AspireHosting.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
