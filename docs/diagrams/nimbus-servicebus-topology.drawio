        <mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;exitX=1.0;exitY=0.4957;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.4957;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="FinanceEndpoint_own" target="fin_ad">
