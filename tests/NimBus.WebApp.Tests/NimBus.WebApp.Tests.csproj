<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>NimBus.WebApp.Tests</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
    <!-- Skip the WebApp's NSwag / npm pipeline when this test project triggers
         a transitive build of the WebApp. Tests reflect over types directly
         and exercise the API/HTTP pipeline; they don't need the SPA bundle. -->
    <SkipSpaBuild>true</SkipSpaBuild>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NimBus.WebApp\NimBus.WebApp.csproj" />
    <ProjectReference Include="..\..\src\NimBus.Testing\NimBus.Testing.csproj" />
    <ProjectReference Include="..\..\src\NimBus.Extensions.Identity\NimBus.Extensions.Identity.csproj" />
    <!-- Simulation end-to-end tests (Simulation/SimulationEmulatorTests.cs) host the Resolver
         in-process and drive the local Service Bus emulator. The emulator is only launched
         (dotnet run no-build), never loaded, so it is built but not referenced. -->
    <ProjectReference Include="..\..\src\NimBus.Resolver\NimBus.Resolver.csproj" />
    <ProjectReference Include="..\..\src\NimBus.ServiceBusEmulator\NimBus.ServiceBusEmulator.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\NimBus.ServiceBusEmulator.Tests\Infrastructure\EmulatorProcess.cs" Link="Simulation\EmulatorProcess.cs" />
  </ItemGroup>

</Project>
