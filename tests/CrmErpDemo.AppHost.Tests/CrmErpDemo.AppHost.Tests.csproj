<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>CrmErpDemo.AppHost.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.5.4" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\CrmErpDemo\CrmErpDemo.AppHost\CrmErpDemo.AppHost.csproj" Aliases="AppHost" />
    <ProjectReference Include="..\..\samples\CrmErpDemo\CrmErpDemo.Contracts\CrmErpDemo.Contracts.csproj" />
    <ProjectReference Include="..\..\samples\CrmErpDemo\PartnerPortal\PartnerPortal.csproj" />
    <ProjectReference Include="..\..\samples\CrmErpDemo\Crm.Api\Crm.Api.csproj" Aliases="CrmApi" />
    <ProjectReference Include="..\..\src\NimBus.Extensions.Identity\NimBus.Extensions.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\samples\CrmErpDemo\CrmErpDemo.AppHost\Properties\launchSettings.json"
             Link="AppHost.launchSettings.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
