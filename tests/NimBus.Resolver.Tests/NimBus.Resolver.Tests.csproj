<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>NimBus.Resolver.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NimBus.Resolver\NimBus.Resolver.csproj" />
    <!-- InMemoryMessageStore: the Spec 030 stale-copy tests run the Resolver against a real
         store that applies StaleWriteGuard, not a fake that answers true. No cycle -
         NimBus.Testing references Core / MessageStore.Abstractions / SDK only. -->
    <ProjectReference Include="..\..\src\NimBus.Testing\NimBus.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit fixture for ResolverHostConfigurationTests, linked under its own name so the
         pin does not depend on the Functions SDK's transitive host.json copy. -->
    <None Include="..\..\src\NimBus.Resolver\host.json" Link="Resolver.host.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
