<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>nb</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nb</ToolCommandName>
    <IsPackable>true</IsPackable>
    <Description>CLI tool for Azure infrastructure provisioning, Service Bus topology setup, and deployment for the NimBus platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    The bicep templates ship inside the tool so `nb infra apply` works without a
    repository clone (ADR-015). LogicalName is set explicitly because the default
    manifest naming folds directory separators into dots, which would make the
    templates/ subdirectory unreconstructable — and deploy.core.bicep resolves its
    modules as 'templates/*.bicep' relative to itself. The names mirror the repo
    layout so BicepTemplateProvider can rebuild it verbatim on extraction.
    %(RecursiveDir) uses the platform separator, so the reader normalizes to '/'.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../../deploy/bicep/**/*.bicep">
      <LogicalName>deploy/bicep/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NimBus.CommandLine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="5.1.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NimBus\NimBus.csproj" />
    <ProjectReference Include="..\NimBus.Core\NimBus.Core.csproj" />
    <ProjectReference Include="..\NimBus.Manager\NimBus.Manager.csproj" />
    <ProjectReference Include="..\NimBus.MessageStore.CosmosDb\NimBus.MessageStore.CosmosDb.csproj" />
    <ProjectReference Include="..\NimBus.ServiceBus\NimBus.ServiceBus.csproj" />
  </ItemGroup>

</Project>
