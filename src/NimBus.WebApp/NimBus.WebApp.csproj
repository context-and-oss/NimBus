<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SpaRoot>ClientApp\</SpaRoot>
    <!-- Shipped as a dotnet tool so an adapter repository's local Aspire stack can run it from
         nuget.org (AddNimBusWebApp). Azure deployments keep using webapp.zip in Akaule.NimBus.Deploy. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nimbus-webapp</ToolCommandName>
    <Description>The NimBus management WebApp, runnable as a dotnet tool for local development.</Description>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    <TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
    <UserSecretsId>kl-esb-mgmt-app</UserSecretsId>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <!-- Transitive from the OpenTelemetry/Azure stack at 2.55.0. Http.Resilience
         applies AddStandardResilienceHandler globally through ServiceDefaults, and
         Microsoft documents 2.63 and earlier as incompatible with it. Nothing here
         registers a gRPC client today, so this is a floor against the day something
         does, and it silences a warning that was firing eight times a build. -->
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.64.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.2" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.14.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Jering.Javascript.NodeJS" Version="7.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Used directly in production code (AgentImplementation JSON-schema validation, spec 022).
         Pinned explicitly rather than relying on NSwag's transitive graph. -->
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <PackageReference Include="NSwag.AspNetCore" Version="14.7.1" />
    <PackageReference Include="NSwag.MSBuild" Version="14.7.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NimBus.WebApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't publish the SPA source files, but do show them in the project files list -->
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**" />
    <Content Include="$(SpaRoot)build\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The tool's own copy under tools/ is all it needs; skip the duplicate content/ folders. -->
    <Content Update="@(Content)" Pack="false" />
  </ItemGroup>

  <!-- Opt-in: bundle an external platform catalog assembly into the publish output (for
       example a container image), so NimBus:PlatformAssembly can name it by file name.
       Pass -p:NimBusPlatformAssemblyPath=<path to the built catalog .dll>. -->
  <ItemGroup Condition="'$(NimBusPlatformAssemblyPath)' != ''">
    <ResolvedFileToPublish Include="$(NimBusPlatformAssemblyPath)" RelativePath="$([System.IO.Path]::GetFileName('$(NimBusPlatformAssemblyPath)'))" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Any Open Api Specifications -->
    <OAS3 Include="$(ProjectDir)./*-spec.yaml" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="ClientApp\public\eet_logo.png" />
    <None Remove="ClientApp\public\nimbus_ascii_logo.png" />
    <None Remove="ClientApp\public\nimbus_ascii_logo.svg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ClientApp\public\eet_logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="ClientApp\public\nimbus_ascii_logo.svg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="ClientApp\public\nimbus_ascii_logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NimBus.Core\NimBus.Core.csproj" />
    <ProjectReference Include="..\NimBus.Extensions.Identity\NimBus.Extensions.Identity.csproj" />
    <ProjectReference Include="..\NimBus.Extensions.IntegrationIntelligence\NimBus.Extensions.IntegrationIntelligence.csproj" />
    <ProjectReference Include="..\NimBus.Manager\NimBus.Manager.csproj" />
    <ProjectReference Include="..\NimBus.Management.ServiceBus\NimBus.Management.ServiceBus.csproj" />
    <ProjectReference Include="..\NimBus.MessageStore.Abstractions\NimBus.MessageStore.Abstractions.csproj" />
    <ProjectReference Include="..\NimBus.MessageStore.CosmosDb\NimBus.MessageStore.CosmosDb.csproj" />
    <ProjectReference Include="..\NimBus.MessageStore.SqlServer\NimBus.MessageStore.SqlServer.csproj" />
    <ProjectReference Include="..\NimBus\NimBus.csproj" />
    <ProjectReference Include="..\NimBus.SDK\NimBus.SDK.csproj" />
    <ProjectReference Include="..\NimBus.ServiceBus\NimBus.ServiceBus.csproj" />
    <ProjectReference Include="..\NimBus.ServiceDefaults\NimBus.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\eet_logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\nimbus_ascii_logo.svg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\nimbus_ascii_logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Place the api specs in the static folder so that we can display them via swagger ui -->
  <Target Name="CopyApiSpecs" AfterTargets="BeforeBuild">
    <Copy SourceFiles="@(OAS3)" DestinationFolder="$(ProjectDir)/wwwroot" />
  </Target>

  <Target Name="NSwag" BeforeTargets="PreBuildEvent" Condition="'$(SkipSpaBuild)' != 'true'">
	  <Exec WorkingDirectory="$(ProjectDir)" EnvironmentVariables="ASPNETCORE_ENVIRONMENT=Development" Command="$(NSwagExe_Net100) run api-gen.nswag" />
  </Target>

  <Target Name="NpmInstall" BeforeTargets="Build" Condition="'$(SkipSpaBuild)' != 'true'">
    <!-- Ensure Node.js is installed -->
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
    </Exec>
    <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE." />
    <Message Importance="high" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
  </Target>

  <Target Name="RebuildClientAssets" BeforeTargets="build" Condition="'$(SkipSpaBuild)' != 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

  <Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish">
    <!-- The SPA is already freshly built by the Build-stage targets (NpmInstall +
         RebuildClientAssets), which dotnet publish runs first — publishing only needs
         to include that output. node_modules is deliberately NOT published: it was
         only ever needed for the Jering SSR path, which is unused (no server.js is
         built and SsrResult has no callers). -->
    <ItemGroup>
      <DistFiles Include="$(SpaRoot)build\**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(DistFiles.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
