<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NimBus.ServiceBusEmulator.AspireHosting</AssemblyName>
    <RootNamespace>NimBus.ServiceBusEmulator.AspireHosting</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Aspire hosting integration for the NimBus Service Bus emulator.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.5.4" />
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

  <ItemGroup>
    <!-- NimBus.AspireHosting runs the other NimBus tools with the same NimBusTools helper; both
         packages are released together at one version. -->
    <InternalsVisibleTo Include="NimBus.AspireHosting" />
    <InternalsVisibleTo Include="NimBus.AspireHosting.Tests" />
    <InternalsVisibleTo Include="NimBus.ServiceBusEmulator.Tests" />
  </ItemGroup>

</Project>
