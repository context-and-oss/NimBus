<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>c486344c-9697-48a0-a95e-bf87ab269415</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The AppHost build targets, and AddDotnetProject for the projects Program.cs adds by path. -->
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.Functions" Version="17.0.0" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.DbGate" Version="17.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Program.cs adds every other project by path (AddDotnetProject), which needs no reference
         here. The Resolver is a Functions project: AddAzureFunctionsProject takes the generated
         Projects.NimBus_Resolver type, so its reference is marked as an Aspire resource. -->
    <ProjectReference Include="..\NimBus.Resolver\NimBus.Resolver.csproj" IsAspireProjectResource="true" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NimBus.ServiceBusEmulator.AspireHosting\NimBus.ServiceBusEmulator.AspireHosting.csproj" />
  </ItemGroup>

</Project>
