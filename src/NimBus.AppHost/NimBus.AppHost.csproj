<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>c486344c-9697-48a0-a95e-bf87ab269415</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Azure.Functions" Version="13.5.4" />
    <!-- Pins a patched transitive version (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); remove once upstream packages depend on >= 10.0.13. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.DbGate" Version="13.5.0" />
    <!-- Force the patched MessagePack over Aspire's vulnerable transitive 2.5.192
         (CVE-2026-48109 et al., patched in 2.5.301). Dev-only host, not shipped,
         but the NuGetAudit gate fails the Release build without this bump.
         A security FLOOR, not a version to keep current: nothing here calls
         MessagePack, and Aspire — which does, for the dashboard's resource stream —
         is built against 2.x. Raise it only when Aspire does. -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NimBus.WebApp\NimBus.WebApp.csproj" />
    <ProjectReference Include="..\NimBus.Resolver\NimBus.Resolver.csproj" />
    <ProjectReference Include="..\NimBus.ServiceBusEmulator\NimBus.ServiceBusEmulator.csproj" />
    <ProjectReference Include="..\NimBus.ServiceBusEmulator.AspireHosting\NimBus.ServiceBusEmulator.AspireHosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\samples\AspirePubSub\AspirePubSub.Provisioner\AspirePubSub.Provisioner.csproj" />
    <ProjectReference Include="..\..\samples\AspirePubSub\AspirePubSub.Publisher\AspirePubSub.Publisher.csproj" />
    <ProjectReference Include="..\..\samples\AspirePubSub\AspirePubSub.Subscriber\AspirePubSub.Subscriber.csproj" />
    <ProjectReference Include="..\..\samples\AspirePubSub\AspirePubSub.WarehouseSubscriber\AspirePubSub.WarehouseSubscriber.csproj" />
  </ItemGroup>

</Project>
