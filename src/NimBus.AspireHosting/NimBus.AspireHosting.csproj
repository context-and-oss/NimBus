<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Aspire hosting for a local NimBus stack from NuGet packages: the Resolver, the WebApp and topology provisioning, run as dotnet tools, alongside the Service Bus emulator.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NimBus.AspireHosting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.5.4" />
    <!-- Pins a patched transitive version (GHSA-qhrr-8q5h-9q3h; Aspire.Hosting brings 2.5.302 through StreamJsonRpc); remove once Aspire depends on >= 2.5.303. -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NimBus.ServiceBusEmulator.AspireHosting\NimBus.ServiceBusEmulator.AspireHosting.csproj" />
  </ItemGroup>

</Project>
