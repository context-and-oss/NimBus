<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NimBus.ServiceBusEmulator</AssemblyName>
    <RootNamespace>NimBus.ServiceBusEmulator</RootNamespace>
    <!-- Shipped as a dotnet tool so an adapter repository can run it from nuget.org
         (AddNimBusServiceBusEmulator(name) runs it with `dotnet tool exec`). -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nimbus-sb-emulator</ToolCommandName>
    <Description>A local, in-memory Azure Service Bus emulator for NimBus development (sessions, scheduling, deferral, dead-lettering), runnable as a dotnet tool.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NimBus.ServiceBusEmulator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- AMQPNetLite.Core is pinned after reviewing its MIT license and 2.5.x
         changelog. Upgrade only with the SDK conformance suite green: the broker
         binds five private/internal members of this library (ListenerLink.Credit,
         Session.SendFlow, SendMessageInternal, an internal constructor, and the
         private deliveryCount field), all resolved at RUNTIME by UnsafeAccessor
         and reflection. A rename in the dependency is therefore a green build and
         a broken broker, which only the tests catch. -->
    <PackageReference Include="AMQPNetLite.Core" Version="2.5.5" />
  </ItemGroup>

</Project>
